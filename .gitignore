# Only what it takes to build the app is under version control: clone, `make app`, done.
# Excluded below: build and runtime output, tests and dev tools, dev docs and local tool
# config, credentials and machine config. User data lives in ~/.scivane/, never in here.

# ── Build and runtime output ────────────────────────────────────────
# var/: the finished app (var/app), build intermediates and the downloaded interpreter and
# dependencies (var/build). Safe to delete.
/var/

# Swift Package Manager / Xcode
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcodeproj/
*.xcworkspace/
*.dSYM/

# distribution artifacts (DMG, notarisation archives)
*.dmg
*.pkg

# ── Tests, checks and dev tools ─────────────────────────────────────
# unit tests and end-to-end checks
/services/reader/tests/
/verify/
# environment checks and setup; development make targets (included from the Makefile)
/scripts/doctor.sh
/scripts/setup_runtime.sh
/dev.mk
# inputs read only when regenerating the lock files (builds use requirements-base.txt), and
# the development package description
/services/reader/requirements-base.in
/services/reader/requirements-ocr.in
/services/reader/pyproject.toml
/.editorconfig

# ── Dev docs and local tool config ──────────────────────────────────
# README.md is for people cloning the repository; docs/ is the development record.
/docs/
/AGENTS.md
/CLAUDE.md
/.claude/
/.codex/
/scripts/check_progress.sh

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ── Credentials and machine config: never committed ─────────────────
# API keys live only in the Keychain; these names guard against stray debug files.
.env
.env.*
credentials.json
providers.json
# signing and notarisation keys
*.p8
*.p12

# ── Editors and system ──────────────────────────────────────────────
.DS_Store
._*
.AppleDouble
Icon?
.idea/
.vscode/
*.swp
*~
